# BFF 本地环境变量模板
# 使用：cp .env.example .env

# Postgres 连接串（本地 docker 默认值）
DATABASE_URL="postgresql://leadops:leadops@localhost:5432/leadops?schema=public"

# 服务端口
PORT=7001

# ingest-service schema 配置文件路径（可选，默认指向同 monorepo 下 ingest-service 的 configs）
# INGEST_SCHEMA_PATH=/absolute/path/to/ingest-schema.yaml
