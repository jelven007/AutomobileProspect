# BFF 本地环境变量模板
# 使用：cp .env.example .env

# Postgres 连接串（本地 docker 默认值）
DATABASE_URL="postgresql://leadops:leadops@localhost:5432/leadops?schema=public"

# 服务端口
PORT=7001

# 本地开发必须显式选择关闭鉴权；生产请删除该变量并配置 JWT_SECRET。
AUTH_DISABLED=true
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_ISSUER=leadops
# JWT_AUDIENCE=leadops-admin

# 生产跨域白名单，多个来源用逗号分隔；生产环境默认不允许浏览器跨域。
# CORS_ORIGINS=https://admin.example.com

# 导入/导出文件目录与资源限制
# DATA_DIR=/var/lib/leadops
# MAX_UPLOAD_MB=512
# IMPORT_CONCURRENCY=1

# ingest-service schema 配置文件路径（可选，默认指向同 monorepo 下 ingest-service 的 configs）
# INGEST_SCHEMA_PATH=/absolute/path/to/ingest-schema.yaml
