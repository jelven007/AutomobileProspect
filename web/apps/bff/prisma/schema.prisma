// BFF 的 Prisma schema。
// 与 ingest-service/migrations/001_init.sql 严格对齐，不走 prisma migrate。
// customer 表是分区表（PARTITION BY RANGE ingest_month），Prisma 不原生支持分区，
// 但只要字段对齐、每条记录带 ingest_month，client 可正常读写。
// 部分唯一索引 uk_customer_document_month (id_type, id_card, ingest_month) WHERE is_deleted=FALSE 由 DDL 兜底，
// Prisma schema 这里不声明 @@unique，避免 push 回去改坏约束。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  customer_id    String    @db.Char(26)
  huji_no        String?   @db.VarChar(32)
  name           String    @db.VarChar(64)
  gender         String?   @db.Char(1)
  birth_date     DateTime? @db.Date
  id_type        String    @default("resident_id") @db.VarChar(32)
  id_card        String?   @db.VarChar(32)
  phone_masked   String?   @db.VarChar(64)
  address        String?   @db.VarChar(256)
  stat_time      DateTime? @db.Timestamptz(6)
  province       String?   @db.VarChar(32)
  city           String?   @db.VarChar(64)
  district       String?   @db.VarChar(64)
  occupation     String?   @db.VarChar(64)
  education      String?   @db.VarChar(32)
  marital_status String?   @db.VarChar(16)
  source_file    String?   @db.VarChar(256)
  source_row     Int?
  ingest_batch   String?   @db.VarChar(64)
  ingest_month   DateTime  @db.Date
  version        Int       @default(1)
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  identities     CustomerIdentity[]
  ingest_rows    IngestRowIdentity[]

  @@id([customer_id, ingest_month])
  @@index([huji_no], map: "idx_customer_huji")
  @@index([id_card], map: "idx_customer_id_card")
  @@index([province], map: "idx_customer_province")
  @@index([city], map: "idx_customer_city")
  @@map("customer")
}

model IngestJob {
  job_id         String    @id @db.VarChar(64)
  source_bucket  String?   @db.VarChar(128)
  source_prefix  String?   @db.VarChar(256)
  file_name      String?   @db.VarChar(256)
  file_path      String?
  file_hash      String?   @db.Char(64)
  status         String    @db.VarChar(16)
  total_rows     BigInt    @default(0)
  success_rows   BigInt    @default(0)
  skipped_rows   BigInt    @default(0)
  duplicate_rows BigInt    @default(0)
  written_rows   BigInt    @default(0)
  inserted_rows  BigInt    @default(0)
  updated_rows   BigInt    @default(0)
  warnings       BigInt    @default(0)
  checkpoint_row BigInt    @default(0)
  warnings_json  Json?
  report_json    Json?
  retry_of       String?   @db.VarChar(64)
  started_at     DateTime? @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)
  error          String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_ingest_job_created")
  @@map("ingest_job")
}

model CustomerIdentity {
  id_type      String   @default("resident_id") @db.VarChar(32)
  id_card      String   @db.VarChar(32)
  customer_id  String   @db.Char(26)
  ingest_month DateTime @db.Date
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  customer     Customer @relation(fields: [customer_id, ingest_month], references: [customer_id, ingest_month], onDelete: Cascade)

  @@id([id_type, id_card])
  @@map("customer_identity")
}

model IngestRowIdentity {
  ingest_batch String   @db.VarChar(64)
  source_file  String   @db.VarChar(256)
  source_row   Int
  customer_id  String   @db.Char(26)
  ingest_month DateTime @db.Date
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  customer     Customer @relation(fields: [customer_id, ingest_month], references: [customer_id, ingest_month], onDelete: Cascade)

  @@id([ingest_batch, source_file, source_row])
  @@map("ingest_row_identity")
}

model ExportJob {
  job_id       String    @id @db.VarChar(64)
  status       String    @db.VarChar(16)
  filters      Json      @default("{}")
  file_path    String?
  file_name    String?   @db.VarChar(256)
  total_rows   BigInt    @default(0)
  processed_rows BigInt  @default(0)
  groups       Int       @default(0)
  completed_groups Int   @default(0)
  requested_by String?   @db.VarChar(128)
  error        String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  started_at   DateTime? @db.Timestamptz(6)
  finished_at  DateTime? @db.Timestamptz(6)
  expires_at   DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_export_job_created")
  @@map("export_job")
}

model AuditLog {
  audit_id    BigInt   @id @default(autoincrement())
  actor       String   @db.VarChar(128)
  action      String   @db.VarChar(64)
  entity_type String   @db.VarChar(64)
  entity_id   String?  @db.VarChar(128)
  before_data Json?
  after_data  Json?
  request_id  String?  @db.VarChar(128)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "idx_audit_log_entity")
  @@map("audit_log")
}

model AdministrativeDivisionDataset {
  dataset_version  String   @id @db.VarChar(32)
  effective_date   DateTime @db.Date
  fetched_at       DateTime @db.Timestamptz(6)
  source_page      String
  source_url       String
  source_table     String   @db.VarChar(64)
  source_hash      String   @db.Char(64)
  province_count   Int
  prefecture_count Int
  county_count     Int
  imported_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("administrative_division_dataset")
}

model AdministrativeDivision {
  dataset_version    String    @db.VarChar(32)
  source_code        String    @db.VarChar(12)
  code               String?   @db.Char(6)
  name               String    @db.VarChar(64)
  level              String    @db.VarChar(16)
  division_type      String    @db.VarChar(32)
  parent_source_code String?   @db.VarChar(12)
  parent_code        String?   @db.Char(6)
  effective_from     DateTime? @db.Date
  effective_to       DateTime? @db.Date
  is_current         Boolean   @default(true)
  source_url         String
  source_hash        String    @db.Char(64)

  @@id([dataset_version, source_code])
  @@unique([dataset_version, code])
  @@index([dataset_version, parent_source_code], map: "idx_administrative_division_parent")
  @@index([dataset_version, name, level], map: "idx_administrative_division_name")
  @@map("administrative_division")
}

model AdministrativeDivisionCrosswalk {
  crosswalk_id           BigInt   @id @default(autoincrement())
  rule_version           String   @db.VarChar(32)
  target_dataset_version String   @db.VarChar(32)
  source_code            String   @db.Char(6)
  source_name            String?  @db.VarChar(64)
  source_level           String   @db.VarChar(16)
  source_type            String?  @db.VarChar(32)
  target_code            String?  @db.Char(6)
  mapping_kind           String   @db.VarChar(32)
  mapping_scope          String   @db.VarChar(16)
  auto_apply             Boolean  @default(false)
  confidence             Int      @db.SmallInt
  evidence               String
  created_at             DateTime @default(now()) @db.Timestamptz(6)

  @@map("administrative_division_crosswalk")
}

model RegionStandardizationBatch {
  region_batch_id     String    @id @db.Char(26)
  dataset_version     String    @db.VarChar(32)
  rule_version        String    @db.VarChar(32)
  source_hash         String    @db.Char(64)
  status              String    @default("PENDING") @db.VarChar(16)
  selection           Json      @default("{}")
  total_rows          BigInt    @default(0)
  processed_rows      BigInt    @default(0)
  current_rows        BigInt    @default(0)
  historical_rows     BigInt    @default(0)
  partial_rows        BigInt    @default(0)
  ambiguous_rows      BigInt    @default(0)
  unresolved_rows     BigInt    @default(0)
  not_applicable_rows BigInt    @default(0)
  changed_rows        BigInt    @default(0)
  worker_id           String?   @db.VarChar(128)
  lease_until         DateTime? @db.Timestamptz(6)
  last_customer_id    String?   @db.Char(26)
  last_ingest_month   DateTime? @db.Date
  started_at          DateTime? @db.Timestamptz(6)
  finished_at         DateTime? @db.Timestamptz(6)
  error               String?
  requested_by        String?   @db.VarChar(128)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "idx_region_standardization_batch_status")
  @@map("region_standardization_batch")
}

model RegionStandardizationStaging {
  region_batch_id         String   @db.Char(26)
  customer_id             String   @db.Char(26)
  ingest_month            DateTime @db.Date
  expected_old_hash       String   @db.Char(64)
  result_hash             String   @db.Char(64)
  origin_region_code      String?  @db.Char(6)
  current_province_code   String?  @db.Char(6)
  current_province_name   String?  @db.VarChar(64)
  current_prefecture_code String?  @db.Char(6)
  current_prefecture_name String?  @db.VarChar(64)
  current_county_code     String?  @db.Char(6)
  current_county_name     String?  @db.VarChar(64)
  current_division_type   String?  @db.VarChar(32)
  region_group_code       String?  @db.Char(6)
  region_group_name       String?  @db.VarChar(64)
  region_group_type       String?  @db.VarChar(32)
  region_source           String   @db.VarChar(32)
  mapping_status          String   @db.VarChar(32)
  mapping_method          String   @db.VarChar(32)
  confidence              Int      @db.SmallInt
  error                   String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  @@id([region_batch_id, customer_id, ingest_month])
  @@index([region_batch_id, mapping_status], map: "idx_region_staging_status")
  @@map("region_standardization_staging")
}

model RegionStandardizationChange {
  change_id       BigInt    @id @default(autoincrement())
  region_batch_id String    @db.Char(26)
  customer_id     String    @db.Char(26)
  ingest_month    DateTime  @db.Date
  old_value_hash  String    @db.Char(64)
  new_value_hash  String    @db.Char(64)
  old_values      Json
  new_values      Json
  mapping_status  String    @db.VarChar(32)
  changed_at      DateTime  @default(now()) @db.Timestamptz(6)
  rolled_back_at  DateTime? @db.Timestamptz(6)

  @@unique([region_batch_id, customer_id, ingest_month], map: "uk_region_standardization_change_customer")
  @@map("region_standardization_change")
}

// ingest_row_log 没有主键，BFF 一期暂不读写它，这里 @@ignore
// 让 Prisma 承认表存在但不生成 CRUD。
model IngestRowLog {
  job_id String? @db.VarChar(64)
  file   String? @db.VarChar(256)
  row_no Int?
  reason String? @db.VarChar(64)
  raw    Json?

  @@index([job_id], map: "idx_ingest_row_log_job")
  @@map("ingest_row_log")
  @@ignore
}
