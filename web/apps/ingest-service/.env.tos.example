# 真实火山 TOS 环境变量（prospect-data / cn-shanghai）
# 用法：cp .env.tos.example .env.tos 后填入真实 AK/SK，然后：
#   set -a; source .env.tos; set +a

PG_URL=postgres://leadops:leadops@localhost:5432/leadops

INGEST_BUCKET=prospect-data
TOS_ENDPOINT=https://tos-s3-cn-shanghai.volces.com
TOS_REGION=cn-shanghai

# 来自 IAM 子账号，权限：tos:GetObject + tos:ListBucket（只读）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
