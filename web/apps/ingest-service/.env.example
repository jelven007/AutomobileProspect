# ingest-service 本地联调环境变量模板
# 使用方式：cp .env.example .env 后按需改；跑之前 `set -a; source .env; set +a`

# ---------- PostgreSQL ----------
# 本地 docker compose 默认值
PG_URL=postgres://leadops:leadops@localhost:5432/leadops

# ---------- 对象存储（任选一组） ----------

# 方案 A：本地 MinIO（docker compose 启动后使用，推荐联调起步）
INGEST_BUCKET=leadops-raw
TOS_ENDPOINT=http://localhost:9000
TOS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# 方案 B：火山引擎 TOS（生产 / 真实环境联调）
# INGEST_BUCKET=your-tos-bucket
# TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# AWS_ACCESS_KEY_ID=AKLT...
# AWS_SECRET_ACCESS_KEY=xxx

# 方案 C：AWS S3
# INGEST_BUCKET=your-aws-bucket
# TOS_ENDPOINT=
# TOS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxx
