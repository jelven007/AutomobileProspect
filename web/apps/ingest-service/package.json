{
  "name": "@leadops/ingest-service",
  "version": "0.0.1",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "ingest:run": "tsx src/cli.ts run",
    "ingest:ls": "tsx src/cli.ts ls",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "china-division": "^2.7.0",
    "exceljs": "^4.4.0",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "ulid": "^2.3.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@leadops/eslint-config": "workspace:*",
    "@leadops/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.5",
    "tsx": "^4.7.2",
    "typescript": "^5.3.3",
    "vitest": "^1.5.0"
  }
}
